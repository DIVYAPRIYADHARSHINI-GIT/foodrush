{
	"name": "foodrush",
	"version": "1.0.0",
	"private": true,
	"description": "FoodRush - Hungry? Order in minutes. Browser-only food ordering and delivery demo app.",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"data": "node scripts/build-data.mjs",
		"art": "node scripts/make-art.mjs",
		"prebuild": "npm run fonts && npm run art && npm run data",
		"dev": "npm run fonts && npm run art && npm run data && vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold warning",
		"test": "vitest run",
		"test:watch": "vitest",
		"probe": "vitest run --config probes/vitest.probe.config.ts probes/e2e.probe.ts",
		"probe:a11y": "vitest run --config probes/vitest.probe.config.ts probes/a11y.probe.ts",
		"test:all": "npm run check && npm run test && npm run probe && npm run probe:a11y && npm run probe:glyph",
		"fonts": "node scripts/make-fonts.mjs",
		"probe:glyph": "vitest run --config probes/vitest.probe.config.ts probes/glyph.probe.ts",
		"probe:live": "vitest run --config probes/vitest.probe.config.ts probes/live.probe.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.6.5",
		"axe-core": "4.14.0",
		"playwright": "1.64.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"dependencies": {
		"@fontsource-variable/plus-jakarta-sans": "5.2.8"
	}
}
